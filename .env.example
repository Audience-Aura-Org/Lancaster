# --- Server ---
PORT=3000
NODE_ENV=development
# Long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me
# Public URL of the site, used in email links
BASE_URL=http://localhost:3000
# Set to 1 when running behind a reverse proxy / load balancer (Nginx, Render, Heroku...)
TRUST_PROXY=0

# --- Business details (shown on the site and in emails) ---
BUSINESS_NAME=Lancaster Pet Movers
BUSINESS_EMAIL=info@lancasterpetmovers.com
BUSINESS_PHONE=
BUSINESS_ADDRESS=Lancaster, PA
# Where new quote requests / contact messages are announced
NOTIFY_EMAIL=info@lancasterpetmovers.com

# --- Email (SMTP). Leave SMTP_HOST empty to write emails to data/outbox/ instead of sending ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Lancaster Pet Movers <info@lancasterpetmovers.com>"

# --- Database file ---
DB_FILE=data/app.db

# --- Live chat: Tawk.to property/widget id. Defaults to the Lancaster Pet Movers chat; set to off to hide it ---
TAWK_PROPERTY=
