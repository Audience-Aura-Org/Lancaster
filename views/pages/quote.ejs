<%- include('../partials/theme-top', { heading: 'Request a Quote' }) %>
<%
  const services = Object.entries(domain.SERVICE_TYPES).filter(([, s]) => s.category === 'pet' && !s.retired);
  const err = (k) => errors[k] ? `<div class="lpm-error">${errors[k]}</div>` : '';
  const val = (k) => values[k] == null ? '' : values[k];
%>
<main class="service-detail-page">
  <div class="container">
    <section class="lpm-intro">
      <div class="lpm-kind-badge"><i class="fa-solid fa-paw"></i> Pet transport quote</div>
      <h1>Tell us about your pet's journey</h1>
      <p>A few details about your pet and the trip help us recommend the safest way to travel. It's free, with no obligation, and we usually reply within one business day.</p>
    </section>

    <form class="lpm-form lpm-form-centered" method="post" action="/quote" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="kind" value="pet">
      <div style="position:absolute;left:-5000px" aria-hidden="true"><input type="text" name="website" tabindex="-1" autocomplete="off"></div>
      <% if (Object.keys(errors).length) { %><div class="lpm-alert" role="alert"><i class="fa-solid fa-circle-exclamation"></i> Please check the highlighted fields.</div><% } %>

      <h2 class="service-section-title">How should your pet travel?</h2>
      <div class="lpm-services <%= errors.service_type ? 'has-error' : '' %>" role="radiogroup" aria-label="Service">
        <% services.forEach(([k, s]) => { %>
          <label class="lpm-service">
            <input type="radio" name="service_type" value="<%= k %>" <%= values.service_type === k ? 'checked' : '' %> required>
            <span><i class="fa-solid <%= s.icon %>"></i><strong><%= s.label %></strong><small><%= s.blurb %></small></span>
          </label>
        <% }) %>
      </div>
      <%- err('service_type') %>
      <p class="lpm-help">Not sure? Pick the closest option and tell us more below. We'll recommend the safest choice for your pet.</p>

      <h2 class="service-section-title">About your pet</h2>
      <div class="row">
        <div class="col-md-6 mb-3 <%= errors.pet_type ? 'has-error' : '' %>">
          <label for="pet_type">Type of pet *</label>
          <select class="form-control" id="pet_type" name="pet_type" required>
            <option value="">Select…</option>
            <% Object.entries(domain.PET_TYPES).forEach(([k, l]) => { %><option value="<%= k %>" <%= values.pet_type === k ? 'selected' : '' %>><%= l %></option><% }) %>
          </select>
          <%- err('pet_type') %>
        </div>
        <div class="col-md-6 mb-3"><label for="pet_name">Pet's name</label><input class="form-control" id="pet_name" name="pet_name" value="<%= val('pet_name') %>"></div>
        <div class="col-md-6 mb-3"><label for="breed">Breed</label><input class="form-control" id="breed" name="breed" value="<%= val('breed') %>"></div>
        <div class="col-md-6 mb-3"><label for="pet_age">Age</label><input class="form-control" id="pet_age" name="pet_age" value="<%= val('pet_age') %>" placeholder="e.g. 3 years"></div>
        <div class="col-md-6 mb-3"><label for="weight_lbs">Weight (lbs)</label><input class="form-control" type="number" min="0" step="0.1" id="weight_lbs" name="weight_lbs" value="<%= val('weight_lbs') %>"></div>
        <div class="col-md-6 mb-3"><label for="pet_count">Number of pets</label><input class="form-control" type="number" min="1" id="pet_count" name="pet_count" value="<%= val('pet_count') %>"></div>
        <div class="col-md-12 mb-3"><label for="special_needs">Health, medication or temperament notes</label><textarea class="form-control" id="special_needs" name="special_needs" rows="3" maxlength="1000" placeholder="e.g. Nervous with strangers, takes daily medication, snub-nosed breed"><%= val('special_needs') %></textarea></div>
      </div>

      <h2 class="service-section-title">Route &amp; timing</h2>
      <div class="row">
        <div class="col-md-6 mb-3 <%= errors.origin ? 'has-error' : '' %>"><label for="origin">Travelling from (city, state / country) *</label><input class="form-control" id="origin" name="origin" value="<%= val('origin') %>" required><%- err('origin') %></div>
        <div class="col-md-6 mb-3 <%= errors.destination ? 'has-error' : '' %>"><label for="destination">Travelling to (city, state / country) *</label><input class="form-control" id="destination" name="destination" value="<%= val('destination') %>" required><%- err('destination') %></div>
        <div class="col-md-6 mb-3 <%= errors.travel_date ? 'has-error' : '' %>"><label for="travel_date">Preferred travel date</label><input class="form-control" type="date" id="travel_date" name="travel_date" value="<%= val('travel_date') %>" data-future><%- err('travel_date') %></div>
      </div>

      <h2 class="service-section-title">Your details</h2>
      <div class="row">
        <div class="col-md-6 mb-3 <%= errors.name ? 'has-error' : '' %>"><label for="name">Full name *</label><input class="form-control" id="name" name="name" value="<%= val('name') %>" autocomplete="name" required><%- err('name') %></div>
        <div class="col-md-6 mb-3 <%= errors.email ? 'has-error' : '' %>"><label for="email">Email *</label><input class="form-control" type="email" id="email" name="email" value="<%= val('email') %>" autocomplete="email" required><%- err('email') %></div>
        <div class="col-md-6 mb-3"><label for="phone">Phone</label><input class="form-control" type="tel" id="phone" name="phone" value="<%= val('phone') %>" autocomplete="tel"></div>
        <div class="col-md-12 mb-3"><label for="message">Anything else we should know?</label><textarea class="form-control" id="message" name="message" rows="3" maxlength="2000"><%= val('message') %></textarea></div>
        <div class="col-md-12 mb-3 <%= errors.consent ? 'has-error' : '' %>">
          <label class="lpm-check"><input type="checkbox" name="consent" <%= values.consent ? 'checked' : '' %>> <span>I agree that <%= business.name %> may contact me about this request (see our <a href="/privacy-policy.html">privacy policy</a>).</span></label>
          <%- err('consent') %>
        </div>
      </div>
      <div class="lpm-submit"><button type="submit" class="btn-default">Request My Pet Quote</button></div>
    </form>

    <section class="lpm-next">
      <div><i class="fa-solid fa-envelope-open-text"></i><strong>1. Confirmation</strong><span>You get an email confirming your request straight away.</span></div>
      <div><i class="fa-solid fa-user-check"></i><strong>2. Review</strong><span>A pet travel coordinator reviews your route and your pet's needs.</span></div>
      <div><i class="fa-solid fa-file-invoice-dollar"></i><strong>3. Written quote</strong><span>You receive a written quote, usually within one business day.</span></div>
    </section>
  </div>
</main>
<%- include('../partials/chat') %>
<%- include('../partials/theme-bottom') %>
