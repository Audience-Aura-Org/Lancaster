<!DOCTYPE html>
<html lang="en">

<head>
    <!-- Meta -->
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
    <meta name="description" content="Pet transport services from <%= business.name %>: door-to-door ground transport, domestic pet flights and international pet relocation.">
    <meta name="keywords" content="">
    <meta name="author" content="<%= business.name %>">
    <!-- Page Title -->
    <title>Pet Transport Services | <%= business.name %></title>
    <!-- Favicon Icon -->
    <link rel="shortcut icon" type="image/x-icon" href="/images/img/favicon.png">
    <!-- Google Fonts Css-->
    <link rel="preconnect" href="https://fonts.googleapis.com/">
    <link rel="preconnect" href="https://fonts.gstatic.com/">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&amp;display=swap" rel="stylesheet">
    <!-- Bootstrap Css -->
    <link href="/css/bootstrap.min.css" rel="stylesheet" media="screen">
    <!-- SlickNav Css -->
    <link href="/css/slicknav.min.css" rel="stylesheet">
    <!-- Swiper Css -->
    <link rel="stylesheet" href="/css/swiper-bundle.min.css">
    <!-- Font Awesome Icon Css-->
    <link href="/css/all.min.css" rel="stylesheet" media="screen">
    <!-- Animated Css -->
    <link href="/css/animate.css" rel="stylesheet">
    <!-- Magnific Css -->
    <link href="/css/magnific-popup.css" rel="stylesheet">
    <!-- Main Custom Css -->
    <link href="/css/custom.css" rel="stylesheet" media="screen">
    <link href="/css/service-list-upgrade.css" rel="stylesheet" media="screen">
<link href="/css/brand.css" rel="stylesheet">
<%- include('../partials/chat') %>
<link href="/css/zoom.css" rel="stylesheet">
</head>

<body class="tt-magic-cursor">

    <!-- Preloader Start -->
    <div class="preloader" role="status" aria-label="Loading page" hidden>
        <span class="preloader-spinner" aria-hidden="true"></span>
    </div>
    <script src="/js/preloader.js"></script>
    <!-- Preloader End -->

    <!-- Magic Cursor Start -->
    <div id="magic-cursor">
        <div id="ball"></div>
    </div>
    <!-- Magic Cursor End -->

    <%- include('../partials/site-header') %>

    <!-- subpage header Start -->
    <div class="page-header parallaxie">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-12">
                    <!-- Page Header box Start -->
                    <div class="page-header-box">
                        <h2 class="text-anime-style-3">Our Pet Services</h2>
                        <nav class="wow fadeInUp" data-wow-delay="0.25s">
                            <ol class="breadcrumb">
                                <li><a href="index.html">Home</a></li>
                                <li> Services</li>
                            </ol>
                        </nav>                                
                    </div>
                    <!-- Page Header Box End -->
                </div>
            </div>
        </div>
    </div>
    <!-- Page Header End -->

    <!-- Services List Page Start -->
    <div class="page-services">
        <div class="container">
            <div class="section-title lpm-center">
                <h3>Pet services</h3>
                <h2>How would you like your pet to <span>travel?</span></h2>
                <p>By road, by air or abroad. Tell us about your pet and we'll recommend the safest option, even if it's the simpler one.</p>
            </div>
            <div class="row justify-content-center">
            <% [
              ['/pet-transport.html', '/images/post-22.jpeg', 'fa-paw', 'Pet Transport Overview', 'How we plan every pet journey: route, paperwork, crate and hand-over.'],
              ['/pet-ground-transport.html', '/images/truck-road.jpg', 'fa-van-shuttle', 'Pet Ground Transport', 'Door-to-door road travel in climate-controlled vehicles, with regular comfort stops.'],
              ['/pet-air-travel.html', '/images/plane-clouds.jpg', 'fa-plane', 'Domestic Pet Flights', 'Airline-booked travel between U.S. airports, with crate sizing and airport pickup.'],
              ['/international-pet-relocation.html', '/images/hero-port-sunset.jpg', 'fa-earth-americas', 'International Relocation', 'Document timelines, USDA endorsement and arrival support for moves abroad.'],
            ].forEach(([href, img, icon, name, text], i) => { %>
                <div class="col-lg-3 col-md-6">
                    <div class="our-service-item wow fadeInUp" data-wow-delay="<%= 0.25 * (i + 1) %>s">
                        <div class="our-service-image"><figure class="image-anime"><img src="<%= img %>" alt=""></figure></div>
                        <div class="our-service-content">
                            <div class="service-content-box">
                                <div class="our-service-icon"><i class="fa-solid <%= icon %>" aria-hidden="true"></i></div>
                                <div class="our-service-title">
                                    <h2><a href="<%= href %>"><%= name %></a></h2>
                                    <p class="service-summary"><%= text %></p>
                                </div>
                            </div>
                            <div class="our-service-content-button"><a href="<%= href %>">Learn More <i class="fa-regular fa-circle-right"></i></a></div>
                        </div>
                    </div>
                </div>
            <% }) %>
            </div>
            <div class="lpm-center-cta"><a href="/quote" class="btn-default">Get a Free Quote</a></div>
        </div>
    </div>
    <!-- Services List Page End -->

    <!-- Main Footer Start  -->
    <%- include('../partials/site-footer') %>

    <!-- Jquery Library File -->
    <script src="/js/jquery-3.7.1.min.js"></script>
    <!-- Bootstrap js File -->
    <script src="/js/bootstrap.min.js"></script>
    <!-- Validator js File -->
    <script src="/js/validator.min.js"></script>
    <!-- SlickNav js File -->
    <script src="/js/jquery.slicknav.js"></script>
    <!-- Swiper js File -->
    <script src="/js/swiper-bundle.min.js"></script>
    <!-- Counter js File -->
    <script src="/js/jquery.waypoints.min.js"></script>
    <script src="/js/jquery.counterup.min.js"></script>
    <!-- Magnific js File -->
    <script src="/js/jquery.magnific-popup.min.js"></script>
    <!-- SmoothScroll -->
    <script src="/js/SmoothScroll.js"></script>
    <!-- Parallax js -->
    <script src="/js/parallaxie.js"></script>
    <!-- MagicCursor js File -->
    <script src="/js/gsap.min.js"></script>
    <script src="/js/magiccursor.js"></script>
    <!-- Text Effect js File -->
    <script src="/js/SplitText.js"></script>
    <script src="/js/ScrollTrigger.min.js"></script>
    <!-- YTPlayer js File -->
    <script src="/js/jquery.mb.YTPlayer.min.js"></script>
    <!-- Wow js File -->
    <script src="/js/wow.js"></script>
    <!-- Main Custom js File -->
    <script src="/js/function.js"></script>
</body>

</html>
