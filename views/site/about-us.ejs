<!DOCTYPE html>
<html lang="en">

<head>
    <!-- Meta -->
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
    <meta name="description" content="Meet <%= business.name %>: a caring team that plans safe road and air travel for dogs, cats, birds and other pets.">
    <meta name="keywords" content="">
    <meta name="author" content="<%= business.name %>">
    <!-- Page Title -->
    <title>About Our Team | <%= business.name %></title>
    <!-- Favicon Icon -->
    <link rel="shortcut icon" type="image/x-icon" href="/images/img/favicon.png">
    <!-- Google Fonts Css-->
    <link rel="preconnect" href="https://fonts.googleapis.com/">
    <link rel="preconnect" href="https://fonts.gstatic.com/">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&amp;display=swap" rel="stylesheet">
    <!-- Bootstrap Css -->
    <link href="/css/bootstrap.min.css" rel="stylesheet" media="screen">
    <!-- SlickNav Css -->
    <link href="/css/slicknav.min.css" rel="stylesheet">
    <!-- Swiper Css -->
    <link rel="stylesheet" href="/css/swiper-bundle.min.css">
    <!-- Font Awesome Icon Css-->
    <link href="/css/all.min.css" rel="stylesheet" media="screen">
    <!-- Animated Css -->
    <link href="/css/animate.css" rel="stylesheet">
    <!-- Magnific Css -->
    <link href="/css/magnific-popup.css" rel="stylesheet">
    <!-- Main Custom Css -->
    <link href="/css/custom.css" rel="stylesheet" media="screen">
<link href="/css/brand.css" rel="stylesheet">
<%- include('../partials/chat') %>
<link href="/css/zoom.css" rel="stylesheet">
</head>

<body class="tt-magic-cursor">

    <!-- Preloader Start -->
    <div class="preloader" role="status" aria-label="Loading page" hidden>
        <span class="preloader-spinner" aria-hidden="true"></span>
    </div>
    <script src="/js/preloader.js"></script>
    <!-- Preloader End -->

    <!-- Magic Cursor Start -->
    <div id="magic-cursor">
        <div id="ball"></div>
    </div>
    <!-- Magic Cursor End -->

    <%- include('../partials/site-header') %>

    <!-- Page header Start -->
    <div class="page-header parallaxie">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-12">
                    <!-- Page Header box Start -->
                    <div class="page-header-box">
                        <h2 class="text-anime-style-3">Our Story</h2>
                        <nav class="wow fadeInUp" data-wow-delay="0.25s">
                            <ol class="breadcrumb">
                                <li><a href="index.html">Home</a></li>
                                <li> About Us</li>
                            </ol>
                        </nav>                                
                    </div>
                    <!-- Page Header Box End -->
                </div>
            </div>
        </div>
    </div>
    <!-- Page Header End -->

    <!-- Transportation Section Start -->
    <div class="home-transportation about-transportation">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-6 col-md-12 order-lg-1 order-md-2 order-2">
                    <!-- Home Transportation Content Start -->
                    <div class="home-transportation-content">
                        <!-- Section Title Start -->
                        <div class="section-title">
                            <h2 class="text-anime-style-3"><span>Pet people,</span> moving pets</h2>
                        </div>
                        <!-- Section Title End -->

                        <!-- Home Transportation Body Start -->
                        <div class="home-transportation-body">
                            <p class="wow fadeInUp" data-wow-delay="0.25s"><%= business.name %> helps families move their dogs, cats, birds and other companions safely, whether that's a drive to the next state or a flight to another continent.</p>
                            <p class="wow fadeInUp" data-wow-delay="0.5s">Every trip has one coordinator who knows your pet's name, routine and needs, from the first quote to the moment you're reunited.</p>
                        </div>
                        <!-- Home Transportation Body End -->

                        <!-- Home Transportation footer Start -->
                        <div class="home-transportation-footer wow fadeInUp"  data-wow-delay="0.75s">
                            <div class="transportation-footer-btn">
                                <a href="/quote" class="btn-default">Get a Free Quote</a>
                            </div>                            
                            <div class="header-contact-us">
                                <a href="mailto:<%= business.email %>"><img src="/images/icon-mail.svg" alt=""><h3>Email Our Team <span><%= business.email %></span></h3></a>
                            </div>    
                        </div>
                        <!-- Home Transportation footer End -->
                    </div>
                    <!-- Home Transportation content End -->
                </div>

                <div class="col-lg-6 col-md-12 order-lg-2 order-md-1 order-1">
                    <!-- Home Transportation Image Start -->
                    <div class="home-transportation-right">
                        <div class="transportation-img-1">
                            <figure class="reveal image-anime">
                                <img src="/images/transportation-img-1.jpg" alt="">
                            </figure>
                        </div>

                        <div class="transportation-img-2">
                            <figure class="reveal image-anime">
                                <img src="/images/transportation-img-2.jpg" alt="">
                            </figure>
                        </div>

                        <!-- Facts Counter Box Start -->
                        <div class="transportation-counter-box wow fadeInUp"  data-wow-delay="0.5s">
                            <h3><span class="counter">25</span>+</h3>
                            <p>Years in Business</p>
                        </div>
                        <!-- Facts Counter Box End -->
                    </div>
                    <!-- Home Transportation Image End -->
                </div>
            </div>
        </div>
    </div>
    <!-- Transportation Section End -->

    <!-- About Transport Section Start -->
    <div class="about-transport">
        <div class="container">
            <div class="row no-gutters">
                <div class="col-md-4">
                    <!-- Transport Item Start -->
                    <div class="transport-item wow fadeInUp" data-wow-delay="0.25s">
                        <!-- Transport Icon Start -->
                        <div class="icon-box">
                            <img src="/images/icon-transport-1.svg" alt="">
                        </div>
                        <!-- Transport Icon End -->

                        <!-- Transport Content Start -->
                        <div class="transport-content">
                            <h3>Pet-first planning</h3>
                            <p>Every route, crate and schedule is chosen around your pet's comfort and safety.</p>
                        </div>
                        <!-- Transport Content End -->
                    </div>
                    <!-- Transport Item End -->
                </div>
               
                <div class="col-md-4">
                    <!-- Transport Item Start -->
                    <div class="transport-item wow fadeInUp" data-wow-delay="0.5s">
                        <!-- Transport Icon Start -->
                        <div class="icon-box">
                            <img src="/images/icon-transport-2.svg" alt="">
                        </div>
                        <!-- Transport Icon End -->

                        <!-- Transport Content Start -->
                        <div class="transport-content">
                            <h3>One coordinator</h3>
                            <p>One person to talk to, from your first question to the final hand-over.</p>
                        </div>
                        <!-- Transport Content End -->
                    </div>
                    <!-- Transport Item End -->
                </div>
                
                <div class="col-md-4">
                    <!-- Transport Item Start -->
                    <div class="transport-item wow fadeInUp" data-wow-delay="0.75s">
                        <!-- Transport Icon Start -->
                        <div class="icon-box">
                            <img src="/images/icon-transport-3.svg" alt="">
                        </div>
                        <!-- Transport Icon End -->

                        <!-- Transport Content Start -->
                        <div class="transport-content">
                            <h3>Road and air</h3>
                            <p>Ground transport, domestic flights and international relocation.</p>
                        </div>
                        <!-- Transport Content End -->
                    </div>
                    <!-- Transport Item End -->
                </div>
            </div>
        </div>
    </div>
    <!-- About Transport Section End -->

    <!-- Our Industry Section Start -->
    <div class="our-indurstry">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-6">
                    <!-- Indurstry Image Start -->
                    <div class="indurstry-image">
                        <figure class="reveal image-anime">
                            <img src="/images/featured-content-img.jpg" alt="">
                        </figure>
                    </div>
                    <!-- Indurstry Image End -->
                </div>
                <div class="col-lg-6">
                    <div class="our-indurstry-content">
                        <!-- Section Title Start -->
                    <div class="section-title">
                        <h2 class="text-anime-style-3">Care for<span> every kind of pet</span></h2>
                    </div>
                    <!-- Section Title End -->

                    <!-- Indurstry Content Start -->
                    <div class="indurstry-content">  
                        <p class="wow fadeInUp" data-wow-delay="0.25s">Dogs, cats, birds and small animals all travel differently. We plan around your pet's breed, age, temperament and health, and around the rules of the airline and the destination.</p> 
                        
                        <ul class="wow fadeInUp" data-wow-delay="0.5s">
                            <li><i class="fa-regular fa-circle-check"></i> Route planning</li>
                            <li><i class="fa-regular fa-circle-check"></i> Travel crate guidance</li>
                            <li><i class="fa-regular fa-circle-check"></i> Door-to-door hand-over</li>
                            <li><i class="fa-regular fa-circle-check"></i> Vet paperwork checklists</li>
                            <li><i class="fa-regular fa-circle-check"></i> International entry rules</li>
                            <li><i class="fa-regular fa-circle-check"></i> Updates at every stage</li>       
                        </ul>

                        <a href="/track" class="btn-default wow fadeInUp" data-wow-delay="0.75s">Track Your Pet</a>                            
                    </div>
                    <!-- Indurstry Content End -->
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Our Industry Section End -->

    <!-- Export Team Section Start -->
    <div class="export-team">
        <div class="container">
            <div class="row">
                <!-- Section Title Start -->
                <div class="section-title">
                    <h2 class="text-anime-style-3">Meet our<span> team</span></h2>
                    <p class="wow fadeInUp" data-wow-delay="0.25s">Our team brings care and attention to detail to every pet journey, and keeps owners informed at every step.</p>
                </div>
                <!-- Section Title End -->
            </div>

            <div class="row">
                <div class="col-lg-3 col-md-6">
                    <!-- Team Item Start -->
                    <div class="team-item wow fadeInUp"  data-wow-delay="0.25s">
                        <div class="team-image">
                            <figure class="image-anime">
                                <img src="/images/team-1.jpg" alt="">
                            </figure>
                        </div>
                        <div class="team-content">
                            <p>Director</p>
                            <h3><a href="#">George Chan</a></h3>
                        </div>
                    </div>
                    <!-- Team Item End -->
                </div>

                <div class="col-lg-3 col-md-6">
                    <!-- Team Item Start -->
                    <div class="team-item wow fadeInUp"  data-wow-delay="0.5s">
                        <div class="team-image">
                            <figure class="image-anime">
                                <img src="/images/team-2.jpg" alt="">
                            </figure>
                        </div>
                        <div class="team-content">
                            <p>Route Manager</p>
                            <h3><a href="#">Emily Johnson</a></h3>
                        </div>
                    </div>
                    <!-- Team Item End -->
                </div>

                <div class="col-lg-3 col-md-6">
                    <!-- Team Item Start -->
                    <div class="team-item wow fadeInUp"  data-wow-delay="0.75s">
                        <div class="team-image">
                            <figure class="image-anime">
                                <img src="/images/team-3.jpg" alt="">
                            </figure>
                        </div>
                        <div class="team-content">
                            <p>Scheduler</p>
                            <h3><a href="#">Sophia Brown</a></h3>
                        </div>
                    </div>
                    <!-- Team Item End -->
                </div>

                <div class="col-lg-3 col-md-6">
                    <!-- Team Item Start -->
                    <div class="team-item wow fadeInUp"  data-wow-delay="0.75s">
                        <div class="team-image">
                            <figure class="image-anime">
                                <img src="/images/team-4.jpg" alt="">
                            </figure>
                        </div>
                        <div class="team-content">
                            <p>Organizer</p>
                            <h3><a href="#">Arita Benson</a></h3>
                        </div>
                    </div>
                    <!-- Team Item End -->
                </div>
            </div>
        </div>
    </div>
    <!-- Export Team Section End -->

    <!-- Our Contract Section Start -->
    <div class="our-contract parallaxie">
        <div class="container">
            <div class="row align-items-center">  
                <div class="col-md-12">
                    <!-- Our Cta Box Start -->
                    <div class="our-cta-box">
                        <div class="our-contract-title">
                            <h2 class="text-anime-style-3">Let's plan your pet's move</h2>
                        </div>
                        <div class="our-contract-body">
                            <p class="wow fadeInUp" data-wow-delay="0.25s">Not sure which option is right for your pet? Tell us about them and we'll recommend the safest way to travel.</p>
                            <a href="/quote" class="btn-default wow fadeInUp" data-wow-delay="0.5s">Get a Free Quote</a>
                        </div>
                    </div>
                    <!-- Our Cta Box End -->
                </div>
            </div>
        </div>
    </div>
    <!-- Our Contract Section End -->

    <!-- Main Footer Start  -->
    <%- include('../partials/site-footer') %>

    <!-- Jquery Library File -->
    <script src="/js/jquery-3.7.1.min.js"></script>
    <!-- Bootstrap js File -->
    <script src="/js/bootstrap.min.js"></script>
    <!-- Validator js File -->
    <script src="/js/validator.min.js"></script>
    <!-- SlickNav js File -->
    <script src="/js/jquery.slicknav.js"></script>
    <!-- Swiper js File -->
    <script src="/js/swiper-bundle.min.js"></script>
    <!-- Counter js File -->
    <script src="/js/jquery.waypoints.min.js"></script>
    <script src="/js/jquery.counterup.min.js"></script>
    <!-- Magnific js File -->
    <script src="/js/jquery.magnific-popup.min.js"></script>
    <!-- SmoothScroll -->
    <script src="/js/SmoothScroll.js"></script>
    <!-- Parallax js -->
	<script src="/js/parallaxie.js"></script>
    <!-- MagicCursor js File -->
    <script src="/js/gsap.min.js"></script>
    <script src="/js/magiccursor.js"></script>
    <!-- Text Effect js File -->
	<script src="/js/SplitText.js"></script>
    <script src="/js/ScrollTrigger.min.js"></script>
    <!-- YTPlayer js File -->
    <script src="/js/jquery.mb.YTPlayer.min.js"></script>
    <!-- Wow js File -->
    <script src="/js/wow.js"></script>
    <!-- Main Custom js File -->
    <script src="/js/function.js"></script>
</body>

</html>
