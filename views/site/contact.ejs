    <!-- Topbar Section Start -->
    <div class="topbar">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-9 col-md-8">
                    <!-- Topbar Contact Information Start -->
                    <div class="topbar-contact-info">
                        <ul>
                            <li><a href="locations.html"><i class="fa-solid fa-location-dot"></i>Global Locations</a></li>
                            <li><a class="topbar-contact-link" href="mailto:<%= business.email %>"><i class="fa-solid fa-envelope"></i><span><strong>Email Our Team</strong> <%= business.email %></span></a></li>
                        </ul>
                    </div>
                    <!-- Topbar Contact Information End -->
                </div>

                <div class="col-lg-3 col-md-4">
                    <!-- Topbar Social Links Start -->
                    <div class="topbar-social-links">
