<!DOCTYPE html>
<html lang="en">

<head>
    <!-- Meta -->
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
    <meta name="description" content="Contact <%= business.name %> about moving your pet: quotes, travel questions and booking help.">
    <meta name="keywords" content="">
    <meta name="author" content="<%= business.name %>">
    <!-- Page Title -->
    <title>Contact Our Team | <%= business.name %></title>
    <!-- Favicon Icon -->
    <link rel="shortcut icon" type="image/x-icon" href="/images/img/favicon.png">
    <!-- Google Fonts Css-->
    <link rel="preconnect" href="https://fonts.googleapis.com/">
    <link rel="preconnect" href="https://fonts.gstatic.com/">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&amp;display=swap" rel="stylesheet">
    <!-- Bootstrap Css -->
    <link href="/css/bootstrap.min.css" rel="stylesheet" media="screen">
    <!-- SlickNav Css -->
    <link href="/css/slicknav.min.css" rel="stylesheet">
    <!-- Swiper Css -->
    <link rel="stylesheet" href="/css/swiper-bundle.min.css">
    <!-- Font Awesome Icon Css-->
    <link href="/css/all.min.css" rel="stylesheet" media="screen">
    <!-- Animated Css -->
    <link href="/css/animate.css" rel="stylesheet">
    <!-- Magnific Css -->
    <link href="/css/magnific-popup.css" rel="stylesheet">
    <!-- Main Custom Css -->
    <link href="/css/custom.css" rel="stylesheet" media="screen">
    
    
    
    
<link href="/css/brand.css" rel="stylesheet">
<%- include('../partials/chat') %>
<link href="/css/zoom.css" rel="stylesheet">
</head>

<body class="tt-magic-cursor">

    <!-- Preloader Start -->
    <div class="preloader" role="status" aria-label="Loading page" hidden>
        <span class="preloader-spinner" aria-hidden="true"></span>
    </div>
    <script src="/js/preloader.js"></script>
    <!-- Preloader End -->

    <!-- Magic Cursor Start -->
    <div id="magic-cursor">
        <div id="ball"></div>
    </div>
    <!-- Magic Cursor End -->

    <%- include('../partials/site-header') %>

    <!-- Page header Start -->
    <div class="page-header parallaxie">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-12">
                    <!-- Page Header box Start -->
                    <div class="page-header-box">
                        <h2 class="text-anime-style-3">Contact Us</h2>
                        <nav class="wow fadeInUp" data-wow-delay="0.25s">
                            <ol class="breadcrumb">
                                <li><a href="index.html">Home</a></li>
                                <li> Contact Us</li>
                            </ol>
                        </nav>                                
                    </div>
                    <!-- Page Header Box End -->
                </div>
            </div>
        </div>
    </div>
    <!-- Page Header End -->

    <!-- Get In Touch Section Start -->
    <div class="get-in-touch">
        <div class="container">
            <div class="row">
                <div class="col-lg-7 col-md-6">
                    <!-- Get Quote Start -->
                    <div class="get-quote">
                        <h2 class="text-anime-style-3">Let’s talk about your pet’s journey</h2>
                        <div class="get-quote-content">
                            <p class="wow fadeInUp" data-wow-delay="0.5s">Tell us what you need to move or how we can help. Our team will get back to you with the next steps.</p>
                        </div>
                        <div class="get-quote-form wow fadeInUp" data-wow-delay="0.75s">
                            <form id="contactForm" action="/contact" method="post" data-toggle="validator"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div style="position:absolute;left:-5000px" aria-hidden="true"><input type="text" name="website" tabindex="-1" autocomplete="off"></div>
                                <div class="row">
                                    <div class="form-group col-md-12 mb-3">
                                        <input type="text" class="form-control" id="name" name="name" placeholder="Your full name" required>
                                        <div class="help-block with-errors"></div>
                                    </div>

                                    <div class="form-group  col-md-12 mb-3">
                                        <input type="email" name="email" class="form-control" id="email" placeholder="Your email address" required>
                                        <div class="help-block with-errors"></div>
                                    </div>

                                    <div class="form-group col-md-12 mb-3">
                                        <textarea name="msg" class="form-control" id="msg" rows="3" placeholder="Tell us about your pet, your route or your question" required></textarea>
                                        <div class="help-block with-errors"></div>
                                    </div>

                                    <div class="col-md-12">
                                        <button type="submit" class="btn-default">Send Message</button>
                                        <div id="msgSubmit" class="h3 hidden"></div>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                    <!-- Get Quote End -->
                </div>

                <div class="col-lg-5 col-md-6">
                    <div class="contact-us">
                        <h2 class="text-anime-style-3">Contact Details</h2>
                        <!-- Contact Us Info Start -->
                        <div class="contact-us-info">
                            <div class="footer-info-box wow fadeInUp" data-wow-delay="0.25s">
                                <div class="icon-box">
                                    <img src="/images/icon-mail.svg" alt="">
                                </div>

                                <p><%= business.email %></p>
                            </div>

                            <div class="footer-info-box wow fadeInUp" data-wow-delay="0.5s">
                                <div class="icon-box">
                                    <img src="/images/icon-location.svg" alt="">
                                </div>

                                <p><a href="locations.html">United States &middot; Australia &middot; United Kingdom &middot; New Zealand &middot; Global</a></p>
                            </div>

                        </div>
                        <!-- Contact Us Info End -->

                        <!-- Contact Us Footer Start -->
                        <div class="contact-us-footer wow fadeInUp" data-wow-delay="1s">
                            <div class="topbar-social-links contact-details">
                                <ul>
                                    <li><a href="#"><i class="fa-brands fa-facebook-f"></i></a></li>
                                    <li><a href="#"><i class="fa-brands fa-twitter"></i></a></li>
                                    <li><a href="#"><i class="fa-brands fa-instagram"></i></a></li>
                                </ul>
                            </div>
                        </div>
                        <!-- Contact Us Footer End -->
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Get In Touch Section End -->

    <!-- Main Footer Start  -->
    <%- include('../partials/site-footer') %>
    

    <!-- Jquery Library File -->
    <script src="/js/jquery-3.7.1.min.js"></script>
    <!-- Bootstrap js File -->
    <script src="/js/bootstrap.min.js"></script>
    <!-- Validator js File -->
    <script src="/js/validator.min.js"></script>
    <!-- SlickNav js File -->
    <script src="/js/jquery.slicknav.js"></script>
    <!-- Swiper js File -->
    <script src="/js/swiper-bundle.min.js"></script>
    <!-- Counter js File -->
    <script src="/js/jquery.waypoints.min.js"></script>
    <script src="/js/jquery.counterup.min.js"></script>
    <!-- Magnific js File -->
    <script src="/js/jquery.magnific-popup.min.js"></script>
    <!-- SmoothScroll -->
    <script src="/js/SmoothScroll.js"></script>
    <!-- Parallax js -->
	<script src="/js/parallaxie.js"></script>
    <!-- MagicCursor js File -->
    <script src="/js/gsap.min.js"></script>
    <script src="/js/magiccursor.js"></script>
    <!-- Text Effect js File -->
	<script src="/js/SplitText.js"></script>
    <script src="/js/ScrollTrigger.min.js"></script>
    <!-- YTPlayer js File -->
    <script src="/js/jquery.mb.YTPlayer.min.js"></script>
    <!-- Wow js File -->
    <script src="/js/wow.js"></script>
    <!-- Main Custom js File -->
    <script src="/js/function.js"></script>
</body>


</html>
