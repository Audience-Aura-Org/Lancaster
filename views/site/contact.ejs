    <!-- Header Start -->
    <header class="main-header">
        <div class="header-sticky">
            <nav class="navbar navbar-expand-lg">
                <div class="container">
                                       <!-- Logo Start -->
<a class="navbar-brand" href="/" aria-label="<%= business.name %> home"><span class="brand-mark"><span class="brand-initials" aria-hidden="true"><i class="fa-solid fa-paw"></i></span><span class="brand-name">Lancaster <small>Pet Movers</small></span></span></a>
<!-- Logo End -->
    
                    <!-- Main Menu Start -->
                    <div class="collapse navbar-collapse main-menu">
                        <ul class="navbar-nav mr-auto" id="menu">
                            <li class="nav-item has-submen"><a class="nav-link" href="index.html">Home</a>
                            </li>
                            <li class="nav-item"><a class="nav-link" href="about-us.html">About Us</a></li>
                            <li class="nav-item has-submenu"><a class="nav-link" href="service.html">Services</a>
                                <ul class="sub-menu">
                                    <li class="nav-item"><a class="nav-link" href="ocean-freight.html">Ocean Freight</a></li>
                                    <li class="nav-item"><a class="nav-link" href="air-freight.html">Air Freight</a></li>
                                    <li class="nav-item"><a class="nav-link" href="cargo-freight.html">Cargo Freight</a></li>
                                    <li class="nav-item"><a class="nav-link" href="express-delivery.html">Express Delivery</a></li>
                                    <li class="nav-item"><a class="nav-link" href="customs-clearance.html">Customs Clearance</a></li>
                                    <li class="nav-item"><a class="nav-link" href="project-cargo.html">Project Cargo</a></li>
                                    <li class="nav-item"><a class="nav-link" href="pet-transport.html">Pet Transport</a></li>
                                </ul>
                            </li>
                            <li class="nav-item"><a class="nav-link" href="reviews.html">Reviews</a></li>
                            <li class="nav-item"><a class="nav-link" href="locations.html">Locations</a></li>
                            <li class="nav-item"><a class="nav-link" href="/track">Track</a></li>                            
                            <li class="nav-item has-submenu"><a class="nav-link" href="#">Pet Delivery</a>
                                <ul class="sub-menu">
                                    <li class="nav-item"><a class="nav-link" href="pet-transport.html">Pet Transport</a></li>
                                    <li class="nav-item"><a class="nav-link" href="faqs.html">FAQs</a></li>
                                </ul>
                            </li>
                            <li class="nav-item"><a class="nav-link" href="contact.html">Contact Us</a></li>
                        </ul>
                    </div>
                    <!-- Main Menu End -->

                    <div class="navbar-toggle"></div>                         
                </div>
            </nav>

            <div class="responsive-menu"></div>
        </div>
    </header>
    <!-- Header End -->

    <!-- Page header Start -->
    <div class="page-header parallaxie">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-12">
                    <!-- Page Header box Start -->
                    <div class="page-header-box">
                        <h2 class="text-anime-style-3">Contact Us</h2>
                        <nav class="wow fadeInUp" data-wow-delay="0.25s">
                            <ol class="breadcrumb">
                                <li><a href="index.html">Home</a></li>
                                <li> Contact Us</li>
                            </ol>
                        </nav>                                
                    </div>
                    <!-- Page Header Box End -->
                </div>
            </div>
        </div>
    </div>
    <!-- Page Header End -->

    <!-- Get In Touch Section Start -->
    <div class="get-in-touch">
        <div class="container">
            <div class="row">
                <div class="col-lg-7 col-md-6">
                    <!-- Get Quote Start -->
                    <div class="get-quote">
                        <h2 class="text-anime-style-3">Let’s talk about your shipment</h2>
                        <div class="get-quote-content">
                            <p class="wow fadeInUp" data-wow-delay="0.5s">Tell us what you need to move or how we can help. Our team will get back to you with the next steps.</p>
                        </div>
                        <div class="get-quote-form wow fadeInUp" data-wow-delay="0.75s">
                            <form id="contactForm" action="/contact" method="post" data-toggle="validator"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div style="position:absolute;left:-5000px" aria-hidden="true"><input type="text" name="website" tabindex="-1" autocomplete="off"></div>
                                <div class="row">
                                    <div class="form-group col-md-12 mb-3">
                                        <input type="text" class="form-control" id="name" name="name" placeholder="Your full name" required>
                                        <div class="help-block with-errors"></div>
                                    </div>

                                    <div class="form-group  col-md-12 mb-3">
                                        <input type="email" name="email" class="form-control" id="email" placeholder="Your email address" required>
                                        <div class="help-block with-errors"></div>
                                    </div>

                                    <div class="form-group col-md-12 mb-3">
                                        <textarea name="msg" class="form-control" id="msg" rows="3" placeholder="Tell us about your shipment or question" required></textarea>
                                        <div class="help-block with-errors"></div>
                                    </div>

                                    <div class="col-md-12">
                                        <button type="submit" class="btn-default">Send Message</button>
                                        <div id="msgSubmit" class="h3 hidden"></div>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                    <!-- Get Quote End -->
                </div>

                <div class="col-lg-5 col-md-6">
                    <div class="contact-us">
                        <h2 class="text-anime-style-3">Contact Details</h2>
                        <!-- Contact Us Info Start -->
                        <div class="contact-us-info">
                            <div class="footer-info-box wow fadeInUp" data-wow-delay="0.25s">
                                <div class="icon-box">
                                    <img src="/images/icon-mail.svg" alt="">
                                </div>

                                <p><%= business.email %></p>
                            </div>

                            <div class="footer-info-box wow fadeInUp" data-wow-delay="0.5s">
                                <div class="icon-box">
                                    <img src="/images/icon-location.svg" alt="">
                                </div>

                                <p><a href="locations.html">United States &middot; Australia &middot; United Kingdom &middot; New Zealand &middot; Global</a></p>
                            </div>

                        </div>
                        <!-- Contact Us Info End -->

                        <!-- Contact Us Footer Start -->
                        <div class="contact-us-footer wow fadeInUp" data-wow-delay="1s">
                            <div class="topbar-social-links contact-details">
                                <ul>
                                    <li><a href="#"><i class="fa-brands fa-facebook-f"></i></a></li>
                                    <li><a href="#"><i class="fa-brands fa-twitter"></i></a></li>
                                    <li><a href="#"><i class="fa-brands fa-instagram"></i></a></li>
                                </ul>
                            </div>
                        </div>
                        <!-- Contact Us Footer End -->
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Get In Touch Section End -->

    <!-- Main Footer Start  -->
    <footer class="main-footer">
        <!-- Mega Footer Start -->
        <div class="mega-footer">
            <div class="container">
                <div class="row">
                    <div class="col-lg-4 col-md-6 col-12">
                        <!-- Footer About Start -->
                        <div class="footer-about">
                            <!-- Footer Heading Start -->
                            <div class="footer-heading">
                                <figure>
                                    <span class="brand-mark brand-mark-footer"><span class="brand-initials" aria-hidden="true"><i class="fa-solid fa-paw"></i></span><span class="brand-name">Lancaster <small>Pet Movers</small></span></span>
                                </figure>
                            </div>
                            <!-- Footer Heading End -->

                            <!-- Footer Content Start -->
                            <div class="footer-content">
                                <p>We help you navigate shipping with clear advice and coordinated transport.</p>
                            </div>
                            <!-- Footer Content End -->

                            <!-- Footer Social Link Start -->
                            <div class="footer-social-link">
                                <ul>
                                    <li><a href="#"><i class="fa-brands fa-facebook-f"></i></a></li>
                                    <li><a href="#"><i class="fa-brands fa-twitter"></i></a></li>
                                    <li><a href="#"><i class="fa-brands fa-instagram"></i></a></li> 
                                </ul>
                            </div>
                            <!-- Footer Social Link End -->
                        </div>  
                        <!-- Footer About End -->                         
                    </div>

                    <div class="col-lg-2 col-md-6 col-12">
                        <!-- Footer links Start -->
                        <div class="footer-links">
                            <div class="footer-info-heading">
                                <h2>Quick Links</h2>
                            </div>
                            <ul>
                                <li><a href="index.html">Home</a></li>
                                <li><a href="about-us.html">About Us</a></li>
                               <li><a href="service.html">Services</a></li>
                                <li><a href="reviews.html">Reviews</a></li>
                                <li><a href="locations.html">Locations</a></li>
                                <li><a href="/track">Track</a></li>
                                <li><a href="contact.html">Contact Us</a></li>
                            </ul>
                        </div>
                        <!-- Footer links End -->
                    </div>                        

                    <div class="col-lg-3 col-md-6 col-12">
                        <!-- Footer Contact Info Start -->
                        <div class="footer-contact-info">
                            <!-- footer info heading Start -->
                            <div class="footer-info-heading">
                                <h2>Contact Us</h2>
                            </div>
                            <!-- footer info heading End -->

                            <!-- Footer Contact Info Box Start -->
                            <div class="footer-contact-box">
                                <div class="footer-info-box">
                                    <div class="icon-box">
                                        <i class="fa-regular fa-envelope"></i>
                                    </div>

                                    <p><%= business.email %></p>
                                </div>

                                <div class="footer-info-box">
                                    <div class="icon-box">
                                        <i class="fa-solid fa-location-dot"></i>
                                    </div>
                                    
                                    <p><a href="locations.html">United States &middot; Australia &middot; United Kingdom &middot; New Zealand &middot; Global</a></p>									
                                </div>

                            </div>
                            <!-- Footer Contact Info Box End -->
                        </div>
                    </div>
                    <!-- Footer Contact Info End -->

                    <!-- Subscribe Newsletters Start  -->
                    <div class="col-lg-3 col-md-6 col-12">
                        <!-- footer info heading Start -->
                        <div class="footer-info-heading">
                            <h2>Newsletter</h2>
                        </div>
                        <!-- footer info heading End -->

                        <!-- Newsletters Content Start -->
                        <div class="newsletters-content">
                            <p>Sign up for shipping news, service updates, and practical logistics insights.</p>
                        </div>
                        <!-- Newsletters Content End -->

                        <!-- Newsletters Form Start -->
                        <div class="newsletters-form">
                            <form id="newslettersForm" action="/subscribe" method="post" class="mail-box"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <div class="row no-gutters">
                                    <div class="form-group col-11">
                                        <input type="email" name="email" class="form-control" placeholder="Your email address" required>
                                    </div>
                                    <div class="col-1">
                                        <button type="submit"><i class="fas fa-paper-plane"></i></button>
                                    </div>
                                </div>
                            </form>
                        </div>
                        <!-- Newsletters Form End -->
                    </div>
                    <!-- Subscribe Newsletters End  -->
                </div>
            </div>
        </div>
        <!-- Mega Footer End -->
    </footer>
    <!-- Main footer End -->

    <!-- Footer Copyright Section Start -->
    <div class="footer-copyright-links">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-6 col-md-7 col-12">
                    <!-- Footer Copyright Content Start -->
                    <div class="footer-copyright">
                        <p>Copyright <%= year %>  <b><%= business.name %>.</b> All rights reserved.</p>
                    </div>
                    <!-- Footer Copyright Content End -->
                </div>
                <div class="col-lg-6 col-md-5 col-12">
                    <!-- Footer Policy Links Start -->
                    <div class="footer-policy-links">
                        <ul>
                            <li><a href="privacy-policy.html">Privacy Policy</a></li>
                            <li><a href="terms-of-service.html">Terms of Service</a></li>
                        </ul>
                    </div>
                    <!-- Footer Policy Links End -->
                </div>
            </div>
        </div>
    </div>
    <!-- Footer Copyright Section End -->
    

