<%# Pet service page (overview + the three services). Data: page (from src/pet-content.js), slug. %>
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
<meta name="description" content="<%= page.description %>">
<title><%= page.title %> | <%= business.name %></title>
<link rel="shortcut icon" href="/images/img/favicon.png">
<link rel="preconnect" href="https://fonts.googleapis.com/">
<link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&amp;display=swap" rel="stylesheet">
<link href="/css/bootstrap.min.css" rel="stylesheet">
<link href="/css/all.min.css" rel="stylesheet">
<link href="/css/custom.css" rel="stylesheet">
<link href="/css/service-detail.css" rel="stylesheet">
<link href="/css/brand.css" rel="stylesheet">
<%- include('../partials/chat') %>
<link href="/css/zoom.css" rel="stylesheet">
</head>
<body>
<%- include('../partials/site-header') %>
<% const svcs = Object.values(domain.SERVICE_TYPES).filter((s) => s.category === 'pet' && !s.retired);
   const quoteHref = '/quote' + (page.service ? '?service=' + page.service : ''); %>
<div class="page-header"><div class="container"><div class="page-header-box">
  <h2><%= page.title %></h2>
  <nav aria-label="Breadcrumb"><ol class="breadcrumb"><li><a href="/">Home</a></li><li><a href="/service.html">Services</a></li><li><%= page.title %></li></ol></nav>
</div></div></div>

<main class="service-detail-page">
  <div class="container">
    <div class="row service-detail-layout">
      <aside class="col-lg-4 order-2 order-lg-1">
        <div class="service-sidebar">
          <div class="service-nav-card"><h3>Pet Services</h3><ul>
            <li><a class="<%= slug === 'pet-transport' ? 'active' : '' %>" href="/pet-transport.html">Pet Transport Overview <i class="fa-solid fa-arrow-right"></i></a></li>
            <% svcs.forEach((s) => { %><li><a class="<%= slug === s.slug ? 'active' : '' %>" href="/<%= s.slug %>.html"><%= s.label %> <i class="fa-solid fa-arrow-right"></i></a></li><% }) %>
          </ul></div>
          <div class="service-help-card"><h3><%= page.help[0] %></h3><p><%= page.help[1] %></p><a href="<%= quoteHref %>">Get a free quote <i class="fa-solid fa-arrow-right ms-2"></i></a></div>
        </div>
      </aside>

      <div class="col-lg-8 order-1 order-lg-2">
        <div class="service-main-image"><img src="<%= page.image %>" alt="<%= page.imageAlt %>"></div>
        <section class="service-overview">
          <div class="service-kicker"><%= page.kicker %></div>
          <h1><%= page.heading %></h1>
          <% page.paragraphs.forEach((p) => { %><p><%= p %></p><% }) %>
        </section>

        <section class="service-features">
          <h2 class="service-section-title">What's included</h2>
          <div class="row g-4">
            <% page.features.forEach(([icon, h, p]) => { %>
              <div class="col-md-6"><div class="service-feature"><i class="fa-solid <%= icon %>"></i><h3><%= h %></h3><p><%= p %></p></div></div>
            <% }) %>
          </div>
        </section>

        <section class="service-process">
          <h2 class="service-section-title"><%= page.stepsTitle %></h2>
          <div class="row g-4">
            <% page.steps.forEach(([h, p], i) => { %>
              <div class="col-md-6 col-xl-3"><div class="service-process-step"><div class="service-process-number">0<%= i + 1 %></div><h3><%= h %></h3><p><%= p %></p></div></div>
            <% }) %>
          </div>
        </section>

        <section class="service-faqs">
          <h2 class="service-section-title">Common questions</h2>
          <div class="accordion" id="svcFaq">
            <% page.faqs.forEach(([q, a], i) => { %>
              <div class="accordion-item">
                <h3><button class="accordion-button<%= i ? ' collapsed' : '' %>" type="button" data-bs-toggle="collapse" data-bs-target="#faq<%= i %>" aria-expanded="<%= i ? 'false' : 'true' %>"><%= q %></button></h3>
                <div id="faq<%= i %>" class="accordion-collapse collapse<%= i ? '' : ' show' %>" data-bs-parent="#svcFaq"><div class="accordion-body"><%= a %></div></div>
              </div>
            <% }) %>
          </div>
        </section>

        <div class="service-cta"><div><h2><%= page.cta[0] %></h2><p><%= page.cta[1] %></p></div><a href="<%= quoteHref %>" class="btn-default">Get a Free Quote</a></div>
      </div>
    </div>
  </div>
</main>
<%- include('../partials/site-footer') %>
<script src="/js/jquery-3.7.1.min.js"></script>
<script src="/js/bootstrap.min.js"></script>
<script src="/js/service-navigation.js"></script>
</body>
</html>
