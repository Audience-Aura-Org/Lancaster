<%- include('_top') %>
<div class="admin-head"><div><h1>Team accounts</h1><div class="sub">Owners can manage accounts. Staff can manage quotes, bookings, customers and messages.</div></div></div>
<div class="admin-grid cols-2">
  <section class="panel table-wrap">
    <table class="table">
      <thead><tr><th>Name</th><th>Role</th><th>Last sign-in</th><th>Status</th><th></th></tr></thead>
      <tbody>
      <% rows.forEach((u) => { %>
        <tr>
          <td data-label="Name"><strong><%= u.name %></strong><br><small class="muted"><%= u.email %></small></td>
          <td data-label="Role"><%= u.role %></td>
          <td data-label="Last sign-in"><%= u.last_login_at || 'Never' %></td>
          <td data-label="Status"><span class="status <%= u.active ? 'status-completed' : 'status-cancelled' %>"><%= u.active ? 'Active' : 'Disabled' %></span></td>
          <td data-label="">
            <% if (u.id !== admin.id) { %>
              <form method="post" action="/admin/users/<%= u.id %>/toggle" class="inline-form" data-confirm="<%= u.active ? 'Disable' : 'Enable' %> <%= u.email %>?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-sm <%= u.active ? 'btn-danger' : 'btn-outline' %>" type="submit"><%= u.active ? 'Disable' : 'Enable' %></button></form>
              <details style="margin-top:8px"><summary style="cursor:pointer;font-size:13px">Reset password</summary>
                <form method="post" action="/admin/users/<%= u.id %>/password" class="form-grid" style="margin-top:8px"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="password" name="password" minlength="10" placeholder="New password (10+ chars)" autocomplete="new-password" required><button class="btn btn-dark btn-sm" type="submit">Set password</button></form>
              </details>
            <% } else { %><small class="muted">You</small><% } %>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </section>
  <section class="panel">
    <h2><i class="fa-solid fa-user-plus"></i> Add a team member</h2>
    <form method="post" action="/admin/users" class="form-grid">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field"><label>Name</label><input type="text" name="name" required></div>
      <div class="field"><label>Email</label><input type="email" name="email" required></div>
      <div class="field"><label>Role</label><select name="role"><option value="staff">Staff</option><option value="owner">Owner</option></select></div>
      <div class="field"><label>Temporary password</label><input type="password" name="password" minlength="10" autocomplete="new-password" required><div class="hint">Share it securely; they can change it under "My account".</div></div>
      <button class="btn btn-primary btn-sm" type="submit">Create account</button>
    </form>
  </section>
</div>
<%- include('_bottom') %>
